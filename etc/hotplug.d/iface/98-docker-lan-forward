#!/bin/sh
# 任何介面 ifup 後補上 DOCKER-USER 的 LAN->WAN 放行規則。
# 原因見 /etc/myscript/docker-lan-forward.sh 開頭註解(Docker 的 iptables
# FORWARD policy DROP 會吃掉 LAN client 的對外流量)。
#
# ⚠️ 刻意不做介面白名單/黑名單: firewall reload / dockerd restart 都會重建
#    iptables 鏈讓規則消失, 而觸發 ifup 的未必是 wan —— dockerd 重啟時起來
#    的是 'docker' 這個 interface。原本只認 wan/wan6/wan_usb/lan, 正好漏掉
#    規則最可能消失的那個時機。日後新增介面也不必回來改這裡(2026-09-09)。
#    成本極低: 腳本冪等(先刪再加), 沒裝 Docker 會在第 5 行 exit 0,
#    規則沒變動時不寫 log。
[ "$ACTION" = "ifup" ] || exit 0
[ -x /etc/myscript/docker-lan-forward.sh ] || exit 0
/etc/myscript/docker-lan-forward.sh >/dev/null 2>&1 &
