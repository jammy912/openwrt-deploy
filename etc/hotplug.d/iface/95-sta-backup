#!/bin/sh
# STA 備援: wwan 介面起落時重建/清除 policy routing 規則
#
# ★ 為什麼需要這支: wwan 的位址是鄰居 AP 的 DHCP 給的, 每次續約都可能不同。
#   sta-backup.sh 的規則是 `ip rule add from <實際位址>`, 位址一換舊規則就
#   失效, 流量會落回主表 —— 而主表刻意沒有上游路由(defaultroute=0),
#   結果是備援靜默失效, 沒有任何錯誤訊息。
# ⚠️ 只處理 wwan, 其他介面一律放行, 不可漏掉這個判斷。
#
# ⚠️ DNS upstream 的接手「不放這裡」(2026-09-28 實測教訓): 曾在此加
#   sta_dns_take(), 結果備份檔寫出來了但 uci 沒換成上游 DNS, 連 logger
#   那行都沒留下紀錄 —— 函式跑到一半中斷, 極可能是中間的
#   `/etc/init.d/dnsmasq reload` 把 netifd 觸發的 hotplug 自己帶掉了。
#   已改放 sta-backup.sh 的 sta_rules_apply()(獨立 cron, 不受 netifd
#   生命週期影響, 且每分鐘重查跟得上續約)。

[ "$INTERFACE" = "wwan" ] || exit 0
[ -x /etc/myscript/sta-backup.sh ] || exit 0

case "$ACTION" in
    ifup)
        logger -t sta-backup "hotplug: wwan ifup → 重建 policy routing"
        /etc/myscript/sta-backup.sh rules-refresh >/dev/null 2>&1
        ;;
    ifdown)
        logger -t sta-backup "hotplug: wwan ifdown → 清除 policy routing"
        /etc/myscript/sta-backup.sh rules-clear >/dev/null 2>&1
        ;;
esac

exit 0
