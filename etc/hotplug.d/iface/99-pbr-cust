#!/bin/sh
# wg* / wan 介面 ifup 時若 dbroute conf 內有對應項目就重套 dbroute
# pbr-cust 由 rc.d/S99 + sync-googleconfig + check-pbr-wg.sh 處理

case "$INTERFACE" in
    wg*|wan)
        [ "$ACTION" = "ifup" ] || exit 0
        # ⚠️ STA 備援供網期間不能跑這段(2026-09-27 實測)。
        #   dbroute-setup 會以 wan 為出口重建規則, 但 WAN 此時是斷的:
        #     23:18:49 pbr-cust: wg0 up → 執行 dbroute-setup
        #     23:18:49 dbroute: Domain routing via wan (table 254/main) configured
        #     23:18:49 netifd: Interface 'wg_900'/'wg0'/'wg3' is now down
        #   現行策略(2026-09-28)是 STA 期間直接停掉 wg/PBR/DBR, 這個守衛仍要
        #   留著 —— sta-backup.sh 拆除時會 ifup wg, 那一刻 state 可能還是
        #   active, 擋掉一次無謂的重建。還原由 sta-backup.sh 負責。
        if [ "$(cat /tmp/.sta_backup_state 2>/dev/null)" = "active" ]; then
            logger -t pbr-cust "$INTERFACE up → STA 備援供網中, 跳過 dbroute 重建"
            exit 0
        fi
        if grep -q "route_${INTERFACE}_v4" /etc/dnsmasq.d/dbroute-domains.conf 2>/dev/null; then
            logger -t pbr-cust "$INTERFACE up → 執行 dbroute-setup"
            /etc/myscript/dbroute-setup.sh
            # 順便重新解析所有 dbroute 域名填充 nftset
            # (避免 client 端 DNS cache + 舊 IP 已從 nftset timeout 造成流量沒走 fwmark)
            logger -t pbr-cust "$INTERFACE up → 觸發 dbroute-refresh"
            (sleep 5; /etc/myscript/dbroute-refresh.sh) &
        fi
        ;;
esac
